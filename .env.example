# Clé API Anthropic — obtenir sur https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optionnel : surcharger les modèles Claude
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5

# Optionnel mais recommandé en production (sessions + rate limiting distribués)
# REDIS_URL=redis://localhost:6379/0

# Origines frontend autorisées en CORS côté FastAPI (liste séparée par des virgules)
# FRONTEND_ORIGINS=http://localhost:3000,https://votre-frontend.vercel.app
